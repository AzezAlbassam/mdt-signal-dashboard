//@version=6
// SPY Expected Move — daily, weekly and month-to-date bands.
//
// Reconstructed from charts published by the Figuring Out Money YouTube channel.
// Independent work, not affiliated with or endorsed by that channel or TrendSpider.
//
// Each band is a close, a volatility and a horizon, drawn symmetrically about the
// close it hangs on:
//
//     half width = close x volatility x sqrt(sessions / 365)
//
// Two families are drawn per horizon. The iVol family reads a smooth thirty-day
// volatility and barely moves day to day. The plain family prices the actual
// expiry, so it widens into an inflation print or a Fed meeting and collapses
// over a weekend. The shaded interval between them is the zone.
//
// IMPORTANT: this platform cannot read an option chain, so the plain family
// cannot be computed here. Type the straddle in, or let it be derived from the
// iVol band. See the notes at the foot of this file.

indicator("SPY Expected Move", "EM", overlay = true, max_lines_count = 80, max_labels_count = 80)

// ─────────────────────────────────────────────────────────────── model

gM = "Model"
weeklySessions  = input.int(5,  "Sessions in the weekly horizon", minval = 1, maxval = 7, group = gM,
     tooltip = "Five in a normal week. Four when a holiday closes the Friday. The published charts are consistent with either, so this is left as a choice.")
monthlySessions = input.int(21, "Sessions in the month", minval = 15, maxval = 23, group = gM,
     tooltip = "Trading days in the current calendar month. 20 to 22 in practice.")
showDaily   = input.bool(true, "Daily",         group = gM, inline = "show")
showWeekly  = input.bool(true, "Weekly",        group = gM, inline = "show")
showMonthly = input.bool(true, "Month to date", group = gM, inline = "show")

// ───────────────────────────────────────────────── the iVol family

gV = "iVol family — smooth volatility"
ivSource = input.string("From VIX", "Volatility source", options = ["From VIX", "Manual"], group = gV)
ivManual = input.float(15.0, "Manual volatility, per cent", minval = 1, maxval = 200, step = 0.25, group = gV)
vixShare = input.float(0.92, "IV30 as a share of VIX", minval = 0.5, maxval = 1.5, step = 0.01, group = gV,
     tooltip = "Across fifteen published charts the iVol daily band implied 0.88 to 0.96 of the VIX close, averaging 0.92. Only used when the source is VIX. Over a decade of SPY sessions the multiplier that makes this a true one-sigma band is 0.89; 0.92 reproduces the published charts and is within noise of it.")

// ──────────────────────────────────────────────── the plain family

gP = "Plain family — the expiry's own price"
plainSource = input.string("Scaled from iVol", "Source",
     options = ["Scaled from iVol", "Manual straddle"], group = gP,
     tooltip = "An option chain is not available here. Either type the at-the-money straddle of each expiry, or scale the iVol band by a constant.")
plainScale  = input.float(0.798, "Scale factor", minval = 0.3, maxval = 1.6, step = 0.001, group = gP,
     tooltip = "0.798 is the ratio of an at-the-money straddle to a one standard deviation move. Note the real plain band is event driven and ranged from 0.63 to 1.09 of the iVol band across the published charts, so a constant is an approximation.")
plainDailyIn   = input.float(0, "Daily straddle, dollars",         minval = 0, step = 0.01, group = gP)
plainWeeklyIn  = input.float(0, "Weekly straddle, dollars",        minval = 0, step = 0.01, group = gP)
plainMonthlyIn = input.float(0, "Month-to-date straddle, dollars", minval = 0, step = 0.01, group = gP)

// ─────────────────────────────────────────────────────────── styling

gS = "Style"
colIvol    = input.color(#4A90D9,               "iVol lines",   group = gS)
colPlain   = input.color(#C8C8C0,               "Plain lines",  group = gS)
colWeekly  = input.color(#E8A33D,               "Weekly lines", group = gS)
colUpZone  = input.color(color.new(#93412F, 78), "Upper zone",  group = gS)
colDnZone  = input.color(color.new(#4C6839, 76), "Lower zone",  group = gS)
extendBars = input.int(26, "Project this many bars right", minval = 4, maxval = 200, group = gS)

gE = "Extras — what a decade of sessions actually supports"
useRegime = input.bool(false, "Calibrate the band to the volatility regime", group = gE,
     tooltip = "OFF reproduces the published charts, which plot one constant multiple of volatility. ON rescales the band to a true one standard deviation using a multiplier refitted per VIX tercile on a rolling 500-session window. Over 2,688 SPY sessions the constant realised a mean |z| of 0.64 in the calmest third and 0.90 in the most stressed, against 0.798 for a true one sigma; the regime version cuts the weighted calibration error from 0.077 to 0.011. This is the only change to the indicator that survived a walk-forward test. It will not match the published lines.")
regimeBase = input.float(0.92, "Multiple already in the band", minval = 0.3, maxval = 2, step = 0.01, group = gE,
     tooltip = "What the plotted volatility is worth as a multiple of VIX. The band is rescaled by the regime multiplier divided by this.")
regimeCutLo = input.float(16.35, "VIX cut, calm to normal",    minval = 5, maxval = 60, step = 0.01, group = gE)
regimeCutHi = input.float(18.67, "VIX cut, normal to stressed", minval = 5, maxval = 60, step = 0.01, group = gE)
regimeKLo   = input.float(0.7291, "Multiplier, calm",     minval = 0.3, maxval = 2, step = 0.0001, group = gE)
regimeKMid  = input.float(0.8115, "Multiplier, normal",   minval = 0.3, maxval = 2, step = 0.0001, group = gE)
regimeKHi   = input.float(0.9804, "Multiplier, stressed", minval = 0.3, maxval = 2, step = 0.0001, group = gE)

showOuter = input.bool(false, "Outer two-sigma line", group = gE,
     tooltip = "A geometric target, NOT an edge. After a close through the inner band the two-sigma line was reached within that session or the next 57.5% of the time (n=783), which is what a random walk of the same width gives for free (58%), and 31% of those reaches had already happened before the close that defined the setup. Of the breaks that had not already reached it, 38% did next session. Draw it as a target if it helps you place an order; do not read it as a signal.")
outerMult = input.float(2.0, "Outer multiple", minval = 1.25, maxval = 3, step = 0.25, group = gE)
showGap  = input.bool(true, "Flag a band the session opened beyond", group = gE,
     tooltip = "A fill note, not a signal. A level the session opened past never traded, so no order could have been filled there. 22% of lower-band touches and 14% of upper-band touches over the decade were gaps through at the open. Filtering trades on it does not improve anything; it just stops you counting fills you could never have had.")
showLabels = input.bool(true, "Labels", group = gS)

// ──────────────────────────────────────────────────────── the closes
// close[1] on a higher timeframe is the last completed period's close, which is
// exactly what each band hangs on: yesterday for the daily, the previous Friday
// for the weekly, the previous month end for the monthly.

dailyAnchor   = request.security(syminfo.tickerid, "D", close[1])
weeklyAnchor  = request.security(syminfo.tickerid, "W", close[1])
monthlyAnchor = request.security(syminfo.tickerid, "M", close[1])
vixClose      = request.security("CBOE:VIX",       "D", close[1], ignore_invalid_symbol = true)

sessionOpen   = request.security(syminfo.tickerid, "D", open)

iv = ivSource == "Manual" or na(vixClose) ? ivManual / 100.0 : (vixClose / 100.0) * vixShare

// The regime multiplier, off by default: the published charts plot a constant.
regimeK() =>
    na(vixClose) ? regimeBase : vixClose <= regimeCutLo ? regimeKLo : vixClose <= regimeCutHi ? regimeKMid : regimeKHi
regimeScale = useRegime and regimeBase > 0 ? regimeK() / regimeBase : 1.0

halfWidth(anchorClose, sessions) =>
    na(anchorClose) or na(iv) ? na : anchorClose * iv * math.sqrt(sessions / 365.0) * regimeScale

ivolDailyHalf   = halfWidth(dailyAnchor,   1)
ivolWeeklyHalf  = halfWidth(weeklyAnchor,  weeklySessions)
ivolMonthlyHalf = halfWidth(monthlyAnchor, monthlySessions)

plainHalf(typedIn, ivolHalf) =>
    plainSource == "Manual straddle" and typedIn > 0 ? typedIn : ivolHalf * plainScale

plainDailyHalf   = plainHalf(plainDailyIn,   ivolDailyHalf)
plainWeeklyHalf  = plainHalf(plainWeeklyIn,  ivolWeeklyHalf)
plainMonthlyHalf = plainHalf(plainMonthlyIn, ivolMonthlyHalf)

// ───────────────────────────────────────────────────────── the drawing

var line[]     lines  = array.new<line>()
var label[]    labels = array.new<label>()
var linefill[] fills  = array.new<linefill>()

drawLevel(price, col, style, txt) =>
    line result = na
    if not na(price)
        l = line.new(bar_index, price, bar_index + extendBars, price,
             xloc = xloc.bar_index, color = col, width = 1, style = style)
        array.push(lines, l)
        if showLabels
            array.push(labels, label.new(bar_index + extendBars, price,
                 str.tostring(price, format.mintick) + " " + txt,
                 xloc = xloc.bar_index, style = label.style_label_left,
                 color = color.new(color.black, 100), textcolor = col, size = size.small))
        result := l
    result

if barstate.islast
    for l in lines
        line.delete(l)
    for lb in labels
        label.delete(lb)
    for f in fills
        linefill.delete(f)
    array.clear(lines)
    array.clear(labels)
    array.clear(fills)

    if showDaily and not na(dailyAnchor)
        pu = drawLevel(dailyAnchor + plainDailyHalf, colPlain, line.style_solid,  "DAILY EM")
        pl = drawLevel(dailyAnchor - plainDailyHalf, colPlain, line.style_solid,  "DAILY EM")
        iu = drawLevel(dailyAnchor + ivolDailyHalf,  colIvol,  line.style_dotted, "iVol DAILY EM")
        il = drawLevel(dailyAnchor - ivolDailyHalf,  colIvol,  line.style_dotted, "iVol DAILY EM")
        if not na(pu) and not na(iu)
            array.push(fills, linefill.new(pu, iu, colUpZone))
        if not na(pl) and not na(il)
            array.push(fills, linefill.new(pl, il, colDnZone))
        if showOuter
            drawLevel(dailyAnchor + outerMult * ivolDailyHalf, color.new(colIvol, 35), line.style_dashed, str.tostring(outerMult, "#.##") + "σ DAILY")
            drawLevel(dailyAnchor - outerMult * ivolDailyHalf, color.new(colIvol, 35), line.style_dashed, str.tostring(outerMult, "#.##") + "σ DAILY")
        if showGap and not na(sessionOpen)
            // A session can open past one of the two lines a side and not the other,
            // so the flag is per line. near is the line closer to the anchor.
            loNear = dailyAnchor - math.min(plainDailyHalf, ivolDailyHalf)
            loFar  = dailyAnchor - math.max(plainDailyHalf, ivolDailyHalf)
            upNear = dailyAnchor + math.min(plainDailyHalf, ivolDailyHalf)
            upFar  = dailyAnchor + math.max(plainDailyHalf, ivolDailyHalf)
            if sessionOpen <= loNear
                gappedBoth = sessionOpen <= loFar
                txt = gappedBoth ? "opened below the whole lower zone: no fill in it" : "opened through the nearer lower line: only the outer one can fill"
                array.push(labels, label.new(bar_index, gappedBoth ? loFar : loNear, txt,
                     xloc = xloc.bar_index, style = label.style_label_upper_right, color = color.new(colDnZone, 40), textcolor = colPlain, size = size.small))
            if sessionOpen >= upNear
                gappedBothUp = sessionOpen >= upFar
                txtUp = gappedBothUp ? "opened above the whole upper zone: no fill in it" : "opened through the nearer upper line: only the outer one can fill"
                array.push(labels, label.new(bar_index, gappedBothUp ? upFar : upNear, txtUp,
                     xloc = xloc.bar_index, style = label.style_label_lower_right, color = color.new(colUpZone, 40), textcolor = colPlain, size = size.small))

    if showWeekly and not na(weeklyAnchor)
        wu = drawLevel(weeklyAnchor + plainWeeklyHalf, colWeekly, line.style_solid,  "UPPER WEEKLY EM")
        wl = drawLevel(weeklyAnchor - plainWeeklyHalf, colWeekly, line.style_solid,  "LOWER WEEKLY EM")
        vu = drawLevel(weeklyAnchor + ivolWeeklyHalf,  colWeekly, line.style_dotted, "iVol Weekly EM")
        vl = drawLevel(weeklyAnchor - ivolWeeklyHalf,  colWeekly, line.style_dotted, "iVol Weekly EM")
        if not na(wu) and not na(vu)
            array.push(fills, linefill.new(wu, vu, colUpZone))
        if not na(wl) and not na(vl)
            array.push(fills, linefill.new(wl, vl, colDnZone))
        if showOuter
            drawLevel(weeklyAnchor + outerMult * ivolWeeklyHalf, color.new(colWeekly, 35), line.style_dashed, str.tostring(outerMult, "#.##") + "σ WEEKLY")
            drawLevel(weeklyAnchor - outerMult * ivolWeeklyHalf, color.new(colWeekly, 35), line.style_dashed, str.tostring(outerMult, "#.##") + "σ WEEKLY")

    if showMonthly and not na(monthlyAnchor)
        drawLevel(monthlyAnchor + plainMonthlyHalf, colWeekly, line.style_dashed, "UPPER MTD EM")
        drawLevel(monthlyAnchor - plainMonthlyHalf, colWeekly, line.style_dashed, "LOWER MTD EM")

// A reference for the eye: the close every daily band hangs on.
plot(showDaily ? dailyAnchor : na, "Daily anchor close", color = color.new(colPlain, 55),
     style = plot.style_stepline, linewidth = 1)

// ─────────────────────────────────────────────────────────────── notes
//
// What this reproduces exactly:
//   The anchors. The daily band hangs on the previous session's close, the
//   weekly on the previous Friday's, the monthly on the previous month end.
//   Verified to the cent against fifteen published charts.
//
//   The iVol family, to within the volatility feed. Across those charts the
//   implied volatility held between 0.88 and 0.96 of the VIX close for the
//   daily band and 0.80 to 0.90 for the weekly, so the VIX route lands close.
//
// What it cannot reproduce without an option chain:
//   The plain family. Its implied volatility ran from 0.59 of VIX on a quiet
//   Monday to 1.04 into an inflation print, because it prices the real expiry.
//   No constant scale captures that. For an exact match, type the at-the-money
//   straddle of the next session's expiry and of the Friday expiry into the
//   inputs above each evening. Any broker's option chain shows both.
