//@version=5
// FLT + MOD — study 6 (PROTOCOL-study6.md). Two open indicators in one script, so it fits
// a free TradingView plan:
//   FLT (Four-Line Trend)            — four EMA lines, a cloud, Open/Close Long, Cross Up,
//                                       breakouts and breakout clusters
//   MOD (Multi-Oscillator Divergence) — regular divergence on RSI, MACD, OBV and MFI;
//                                       a signal needs 2 of the 4
// They are built from the PUBLIC description of TBO and TBT Divergence (The Better
// Traders). They are NOT those products: their code is closed and was never seen here.
//
// The rules below are exactly the ones the backtest (engine/study6.js) uses. Settings are
// fixed by the protocol and have no inputs on purpose — changing them would make the
// chart differ from the tested indicator. Use it on the DAILY chart (the tested one).
//
// Signals are decided on a bar's close; the backtest buys at the next bar's open.
// MOD is known 5 bars after the pivot low (the pivot needs 5 bars on its right), so the
// label sits on the bar where it became known, never earlier.
indicator("FLT + MOD (study 6)", shorttitle="FLT+MOD", overlay=true, max_labels_count=500, max_lines_count=500)

showBearish = input.bool(true, "Show bearish divergences (not tested)")
showHidden  = input.bool(false, "Show hidden divergences (not tested)")
showLevels  = input.bool(true, "Show last pivot high/low levels (not tested)")

// ── FLT ───────────────────────────────────────────────────────────────────────────────
fast    = ta.ema(close, 20)
midFast = ta.ema(close, 50)
midSlow = ta.ema(close, 100)
slow    = ta.ema(close, 200)

openLong  = ta.crossover(fast, midFast)
closeLong = ta.crossunder(fast, midFast)
crossUp   = ta.crossover(fast, slow)
crossDown = ta.crossunder(fast, slow) // display only

prevHigh  = ta.highest(high, 20)[1]
prevLow   = ta.lowest(low, 20)[1]
breakout  = close > prevHigh and close > math.max(math.max(fast, midFast), math.max(midSlow, slow))
breakdown = close < prevLow and close < math.min(math.min(fast, midFast), math.min(midSlow, slow)) // display only

var int lastCluster = na
cluster = math.sum(breakout ? 1 : 0, 5) >= 3 and (na(lastCluster) or bar_index - lastCluster > 20)
if cluster
    lastCluster := bar_index

// ── MOD ───────────────────────────────────────────────────────────────────────────────
rsiV = ta.rsi(close, 14)
[macdLine, sigLine, histLine] = ta.macd(close, 12, 26, 9)
obvV = ta.obv
mfiV = ta.mfi(hlc3, 14)

K = 5
pivLow  = true
pivHigh = true
for j = 1 to K
    pivLow  := pivLow  and low[K]  < low[K + j]  and low[K]  < low[K - j]
    pivHigh := pivHigh and high[K] > high[K + j] and high[K] > high[K - j]

count(a2, b2, c2, d2, a1, b1, c1, d1, up) =>
    up ? (a2 > a1 ? 1 : 0) + (b2 > b1 ? 1 : 0) + (c2 > c1 ? 1 : 0) + (d2 > d1 ? 1 : 0) :
         (a2 < a1 ? 1 : 0) + (b2 < b1 ? 1 : 0) + (c2 < c1 ? 1 : 0) + (d2 < d1 ? 1 : 0)

// previous pivot low / high: bar, price and the four oscillators at that bar
var int   pl1  = na
var float pl1p = na
var float pl1r = na
var float pl1m = na
var float pl1o = na
var float pl1f = na
var int   ph1  = na
var float ph1p = na
var float ph1r = na
var float ph1m = na
var float ph1o = na
var float ph1f = na

modBull = false
modBear = false
hidBull = false
hidBear = false
modN = 0
if pivLow
    p2 = bar_index - K
    if not na(pl1) and p2 - pl1 <= 60
        if low[K] < pl1p
            modN := count(rsiV[K], macdLine[K], obvV[K], mfiV[K], pl1r, pl1m, pl1o, pl1f, true)
            modBull := modN >= 2
        else if low[K] > pl1p
            hidBull := count(rsiV[K], macdLine[K], obvV[K], mfiV[K], pl1r, pl1m, pl1o, pl1f, false) >= 2
        if modBull or (showHidden and hidBull)
            line.new(pl1, pl1p, p2, low[K], color=modBull ? color.lime : color.new(color.lime, 60), width=2, style=modBull ? line.style_solid : line.style_dotted)
    pl1  := p2
    pl1p := low[K]
    pl1r := rsiV[K]
    pl1m := macdLine[K]
    pl1o := obvV[K]
    pl1f := mfiV[K]
if pivHigh
    p2 = bar_index - K
    if not na(ph1) and p2 - ph1 <= 60
        if high[K] > ph1p
            modBear := count(rsiV[K], macdLine[K], obvV[K], mfiV[K], ph1r, ph1m, ph1o, ph1f, false) >= 2
        else if high[K] < ph1p
            hidBear := count(rsiV[K], macdLine[K], obvV[K], mfiV[K], ph1r, ph1m, ph1o, ph1f, true) >= 2
        if (showBearish and modBear) or (showHidden and hidBear)
            line.new(ph1, ph1p, p2, high[K], color=modBear ? color.red : color.new(color.red, 60), width=2, style=modBear ? line.style_solid : line.style_dotted)
    ph1  := p2
    ph1p := high[K]
    ph1r := rsiV[K]
    ph1m := macdLine[K]
    ph1o := obvV[K]
    ph1f := mfiV[K]

// DB: the first breakout 1..20 bars after a MOD bullish signal (one per MOD signal)
var int  lastMod = na
var bool used = true
db = false
if breakout and not used and not na(lastMod) and bar_index - lastMod >= 1 and bar_index - lastMod <= 20
    db := true
    used := true
if modBull
    lastMod := bar_index
    used := false

// ── drawing ───────────────────────────────────────────────────────────────────────────
pf = plot(midFast, "Mid Fast EMA 50", color.new(color.teal, 30))
ps = plot(midSlow, "Mid Slow EMA 100", color.new(color.orange, 30))
fill(pf, ps, midFast > midSlow ? color.new(color.teal, 80) : color.new(color.red, 80), title="Cloud")
plot(fast, "Fast EMA 20", color.new(color.aqua, 0), 2)
plot(slow, "Slow EMA 200", color.new(color.purple, 0), 2)

var float lastPH = na
var float lastPL = na
if pivHigh
    lastPH := high[K]
if pivLow
    lastPL := low[K]
plot(showLevels ? lastPH : na, "Resistance (last pivot high)", color.new(color.red, 50), 1, plot.style_circles)
plot(showLevels ? lastPL : na, "Support (last pivot low)", color.new(color.green, 50), 1, plot.style_circles)

plotshape(breakout and not cluster, "Breakout", shape.circle, location.abovebar, color.new(color.white, 30), size=size.tiny)
plotshape(cluster, "Breakout cluster (BC)", shape.diamond, location.abovebar, color.white, size=size.small, text="BC", textcolor=color.white)
plotshape(breakdown, "Breakdown (not tested)", shape.circle, location.belowbar, color.new(color.gray, 30), size=size.tiny)
plotshape(openLong, "Open Long (OL)", shape.triangleup, location.belowbar, color.lime, size=size.small, text="OL", textcolor=color.lime)
plotshape(closeLong, "Close Long", shape.xcross, location.abovebar, color.orange, size=size.small, text="CL", textcolor=color.orange)
plotshape(crossUp, "Cross Up (CU)", shape.arrowup, location.belowbar, color.aqua, size=size.normal, text="CU", textcolor=color.aqua)
plotshape(crossDown, "Cross Down (not tested)", shape.arrowdown, location.abovebar, color.purple, size=size.normal, text="CD", textcolor=color.purple)
plotshape(modBull, "MOD bullish divergence", shape.labelup, location.belowbar, color.new(color.lime, 0), text="DIV", textcolor=color.black)
plotshape(showBearish and modBear, "MOD bearish divergence (not tested)", shape.labeldown, location.abovebar, color.new(color.red, 0), text="DIV", textcolor=color.white)
plotshape(db, "DB: breakout after divergence", shape.star, location.belowbar, color.yellow, size=size.normal, text="DB", textcolor=color.yellow)

// Numeric copies for "Export chart data", so scripts/study6-verify.js can compare them
// bar by bar with the backtest.
plot(openLong ? 1 : 0, "OL", display=display.data_window)
plot(closeLong ? 1 : 0, "CL", display=display.data_window)
plot(crossUp ? 1 : 0, "CU", display=display.data_window)
plot(breakout ? 1 : 0, "BO", display=display.data_window)
plot(cluster ? 1 : 0, "BC", display=display.data_window)
plot(modBull ? 1 : 0, "MOD", display=display.data_window)
plot(db ? 1 : 0, "DB", display=display.data_window)

alertcondition(openLong, "FLT Open Long", "FLT Open Long on {{ticker}}")
alertcondition(closeLong, "FLT Close Long", "FLT Close Long on {{ticker}}")
alertcondition(crossUp, "FLT Cross Up", "FLT Cross Up on {{ticker}}")
alertcondition(cluster, "FLT Breakout cluster", "FLT breakout cluster on {{ticker}}")
alertcondition(modBull, "MOD bullish divergence", "MOD bullish divergence on {{ticker}}")
alertcondition(db, "DB breakout after divergence", "Breakout after MOD divergence on {{ticker}}")
