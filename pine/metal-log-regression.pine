// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// Logarithmic regression band for gold and silver (works on any symbol; built for
// TVC:GOLD / OANDA:XAUUSD and TVC:SILVER / OANDA:XAGUSD on the monthly or weekly chart).
//
//   ln(price) = a + b·t      fitted by least squares, t in years since "Fit from"
//   band      = exp(fit ± k·SD of the residuals)
//
// Why linear time by default: the usual crypto bands regress on log time (a power law since
// the coin's first day). Gold has no first day; a steady long-run growth rate (a straight
// line on a log chart) is the natural shape. Log time is offered for comparison.
//
// Start date ("Auto" picks it from the ticker):
// - gold 1971-08: before Nixon closed the gold window the price was fixed by law ($20.67,
//   then $35), so it says nothing about a market trend. TVC:GOLD goes back to 1833;
//   fitting through the fixed era would drag the line down.
// - silver 1968-07: the US Treasury sold silver at $1.29 until 1967, capping the price,
//   and silver certificates stopped being redeemable on 1968-06-24.
//
// Two ways to fit, and the difference matters:
// - "Past only": each bar's band uses only the prices up to that bar. What you see at any
//   date in the past is what the indicator really said then.
// - "All data": one fit through the whole history to today, drawn back over the past.
//   This is how most published regression bands work. It looks cleaner, because history is
//   fitted with hindsight, and it redraws the past every month.
// On the last bar both are the same fit, so today's reading (the table) does not depend
// on the mode.
//
// Gold since 1971 and silver since 1968 have each had two or three full boom-and-bust
// cycles. That is too few for any statistics: touches of the lower band are a handful of
// episodes, not a proven signal. See reports/study7-gold.txt and reports/study7-silver.txt
// for each episode and what followed.

//@version=6
indicator("Gold / Silver Log Regression Band", shorttitle = "Metal LogReg", overlay = true, max_polylines_count = 12)

startPreset = input.string("Auto", "Fit from", options = ["Auto", "Custom"], inline = "s", tooltip = "Auto: silver (ticker contains SILVER or XAG) from 1968-07, everything else from 1971-08.")
customStart = input.time(timestamp("1971-08-01T00:00:00"), "", inline = "s")
axis       = input.string("Linear time (exponential trend)", "Time axis", options = ["Linear time (exponential trend)", "Log time (power law)"])
mode       = input.string("Past only", "Fit", options = ["Past only", "All data (redraws history)"])
minYears   = input.float(20.0, "Past only: years of data before the band is drawn", minval = 1.0)
k1         = input.float(1.0, "Inner bands (SD)", minval = 0.25, step = 0.25)
k2         = input.float(2.0, "Outer bands (SD)", minval = 0.25, step = 0.25)
projYears  = input.float(3.0, "Project today's fit forward (years)", minval = 0.0, step = 1.0)
showBg     = input.bool(true, "Shade bars below the inner lower band (Past only)")
showTable  = input.bool(true, "Show table")

bool isSilver = str.contains(syminfo.ticker, "SILVER") or str.contains(syminfo.ticker, "XAG")
int startTime = startPreset == "Custom" ? customStart : isSilver ? timestamp("1968-07-01T00:00:00") : timestamp("1971-08-01T00:00:00")

const float YEAR_MS = 365.2425 * 24.0 * 3600.0 * 1000.0
bool logTime = axis == "Log time (power law)"
bool pastMode = mode == "Past only"

xOf(float t) =>
    float yrs = (t - startTime) / YEAR_MS
    logTime ? math.log(yrs + 1.0) : yrs

// ---------------------------------------------------------------- running least squares

var float n   = 0.0
var float sx  = 0.0
var float sy  = 0.0
var float sxx = 0.0
var float sxy = 0.0
var float syy = 0.0
var int   firstTime = na
var array<int> fitTimes = array.new<int>()

bool inFit = time >= startTime and close > 0
float x = xOf(time)
float y = math.log(close)
if inFit
    if na(firstTime)
        firstTime := time
    n   += 1.0
    sx  += x
    sy  += y
    sxx += x * x
    sxy += x * y
    syy += y * y
    fitTimes.push(time)

float den = n * sxx - sx * sx
float b   = n > 2 and den != 0 ? (n * sxy - sx * sy) / den : na
float a   = n > 2 ? (sy - b * sx) / n : na
float sse = a * a * n + b * b * sxx + syy + 2.0 * a * b * sx - 2.0 * a * sy - 2.0 * b * sxy
float sd  = n > 2 ? math.sqrt(math.max(sse, 0.0) / (n - 2.0)) : na

bool  ready = inFit and not na(sd) and (time - firstTime) / YEAR_MS >= minYears
float mid   = a + b * x
float z     = (y - mid) / sd

// ---------------------------------------------------------------- Past only: plotted bar by bar

bool drawPast = pastMode and ready
pMid = plot(drawPast ? math.exp(mid) : na, "Regression", color.new(color.orange, 0), 2)
pU1  = plot(drawPast ? math.exp(mid + k1 * sd) : na, "+inner", color.new(color.red, 50), 1)
pU2  = plot(drawPast ? math.exp(mid + k2 * sd) : na, "+outer", color.new(color.red, 0), 1)
pL1  = plot(drawPast ? math.exp(mid - k1 * sd) : na, "−inner", color.new(color.green, 50), 1)
pL2  = plot(drawPast ? math.exp(mid - k2 * sd) : na, "−outer", color.new(color.green, 0), 1)
fill(pU1, pU2, color.new(color.red, 90))
fill(pL1, pL2, color.new(color.green, 88))
bgcolor(showBg and drawPast and z < -k1 ? color.new(color.green, 85) : na)

// ---------------------------------------------------------------- All data: redrawn on the last bar

var array<polyline> drawn = array.new<polyline>()

curve(array<int> times, float offset) =>
    array<chart.point> pts = array.new<chart.point>()
    int size = times.size()
    int stride = math.max(1, int(math.ceil(size / 2000.0)))
    for i = 0 to size - 1 by stride
        int t = times.get(i)
        pts.push(chart.point.from_time(t, math.exp(a + b * xOf(t) + offset)))
    int tLast = times.get(size - 1)
    if (size - 1) % stride != 0
        pts.push(chart.point.from_time(tLast, math.exp(a + b * xOf(tLast) + offset)))
    pts

projection(float offset) =>
    array<chart.point> pts = array.new<chart.point>()
    for i = 0 to 24
        int t = time + int(projYears * YEAR_MS * i / 24.0)
        pts.push(chart.point.from_time(t, math.exp(a + b * xOf(t) + offset)))
    pts

if barstate.islast and not na(sd) and fitTimes.size() > 1
    for p in drawn
        p.delete()
    drawn.clear()
    array<float> offsets = array.from(0.0, k1 * sd, k2 * sd, -k1 * sd, -k2 * sd)
    array<color> colors  = array.from(color.orange, color.new(color.red, 50), color.red, color.new(color.green, 50), color.green)
    for j = 0 to 4
        if not pastMode
            drawn.push(polyline.new(curve(fitTimes, offsets.get(j)), xloc = xloc.bar_time, line_color = colors.get(j), line_width = j == 0 ? 2 : 1))
        if projYears > 0
            drawn.push(polyline.new(projection(offsets.get(j)), xloc = xloc.bar_time, line_color = colors.get(j), line_style = line.style_dotted, line_width = 1))

// ---------------------------------------------------------------- table (same in both modes)

zone(float zz) =>
    zz < -k2 ? "Below outer lower band" : zz < -k1 ? "Below inner lower band" : zz <= k1 ? "Inside the inner bands" : zz <= k2 ? "Above inner upper band" : "Above outer upper band"

var table info = table.new(position.top_right, 2, 7, bgcolor = chart.bg_color, border_width = 1)
if showTable and barstate.islast and not na(sd)
    table.cell(info, 0, 0, "Fit", text_color = color.gray)
    table.cell(info, 1, 0, mode + ", " + (logTime ? "log time" : "linear time") + ", from " + str.format_time(firstTime, "yyyy-MM"), text_color = chart.fg_color)
    table.cell(info, 0, 1, logTime ? "Power-law exponent" : "Trend growth per year", text_color = color.gray)
    table.cell(info, 1, 1, logTime ? str.tostring(b, "0.00") : str.tostring((math.exp(b) - 1.0) * 100.0, "0.0") + "%", text_color = chart.fg_color)
    table.cell(info, 0, 2, "Position now", text_color = color.gray)
    table.cell(info, 1, 2, (z >= 0 ? "+" : "") + str.tostring(z, "0.00") + " SD — " + zone(z), text_color = z < -k1 ? color.green : z > k1 ? color.red : chart.fg_color)
    table.cell(info, 0, 3, "Regression today", text_color = color.gray)
    table.cell(info, 1, 3, str.tostring(math.exp(mid), format.mintick), text_color = color.orange)
    table.cell(info, 0, 4, "Inner bands", text_color = color.gray)
    table.cell(info, 1, 4, str.tostring(math.exp(mid - k1 * sd), format.mintick) + " – " + str.tostring(math.exp(mid + k1 * sd), format.mintick), text_color = chart.fg_color)
    table.cell(info, 0, 5, "Outer bands", text_color = color.gray)
    table.cell(info, 1, 5, str.tostring(math.exp(mid - k2 * sd), format.mintick) + " – " + str.tostring(math.exp(mid + k2 * sd), format.mintick), text_color = chart.fg_color)
    table.cell(info, 0, 6, "SD of residuals", text_color = color.gray)
    table.cell(info, 1, 6, str.tostring(sd, "0.000") + " (×" + str.tostring(math.exp(sd), "0.00") + " per SD)", text_color = chart.fg_color)
